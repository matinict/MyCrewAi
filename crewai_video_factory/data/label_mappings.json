  "debate_regex_patterns": {
    "_comment": "Regex patterns needing capture groups. Format: [[pattern, replacement], ...]. Applied after debate_labels.",
    "numbered_args": [
      [
        "\\bCOUNTER[\\s\\-]?ARGUMENT\\s*(\\d+)\\s*[:\\-]?",
        "C-Arg \\1:"
      ],
      [
        "\\bARGUMENT\\s*(\\d+)\\s*[:\\-]?",
        "Arg \\1:"
      ]
    ],
    "strip_trailing_to": [
      [
        "(?<=\\s)to\\s+",
        ""
      ]
    ],
    "strip_placeholders": [
      [
        "\\[.*?\\]",
        ""
      ]
    ]
  },
