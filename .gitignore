################################################################################
# 1. PYTHON & ENVIRONMENTS (Recursive)
################################################################################
# Virtual Environments
**/venv/
**/env/
**/.venv/
**/bin/
**/Include/
**/Lib/
**/Scripts/
**/share/python-wheels/

# Python Cache & Metadata
**/__pycache__/
**/*.py[cod]
**/*.so
**/.python-version
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.coverage.*

# uv (modern Python package manager)
.uv/
**/.uv/

################################################################################
# 2. CREDENTIALS & SENSITIVE DATA
################################################################################
**/.env*
**/*.env
**/auth.json
**/*.key
**/*.pem
**/*.crt
**/.netrc
**/secrets.yaml
**/secrets.json

################################################################################
# 3. PROJECT SPECIFIC (CrewAI, n8n, bwriter)
################################################################################
# bwriter output directories
bwriter/output/
bwriter/outpu/          # Keep if this typo exists in your FS
**/output/
**/outputs/
**/@@output/            # engineering_team uses this pattern

# CrewAI artifacts
**/memory/
**/crewai.log
**/crewai_memory.json

# n8n specific
**/.n8n/
**/*.sqlite
**/binaryData/

# ZIP archives (build artifacts/backups – UNCOMMENT if you don't want to commit these)
# *.zip
# *.tar.gz

# Logs & Temporary files
**/*.log
**/logs/
**/temp/
**/tmp/
**/.tmp/
**/.log/

################################################################################
# 4. SYSTEM & EDITORS
################################################################################
.DS_Store
Thumbs.db
**/.vscode/
**/.idea/
**/.ipynb_checkpoints/
**/.vs/
**/tags
**/.tags

################################################################################
# 5. NODE / FRONTEND (If applicable)
################################################################################
**/node_modules/
**/dist/
**/build/
.npm/
**/.npm/
**/package-lock.json
**/yarn.lock
**/.next/
**/.nuxt/

################################################################################
# 6. MISCELLANEOUS
################################################################################
# OS generated
._*
.Spotlight-V100
.Trashes

# Backup files
*~
*.swp
*.swo